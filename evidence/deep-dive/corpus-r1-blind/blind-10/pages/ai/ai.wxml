<view class="container">
  <input type="text" placeholder="输入你的问题" bindinput="onInput"/>
  <button bindtap="submitQuestion">提问</button>
  <view wx:if="{{questions.length > 0}}">
    <block wx:for="{{questions}}" wx:key="index">
      <view class="question">{{item.question}}</view>
      <view class="answer">{{item.answer}}</view>
    </block>
  </view>
</view>